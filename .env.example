# Copy to .env and fill in real values. Never commit .env.
# This is a plain OpenAI API key — call api.openai.com directly, no custom base URL.
OPENAI_API_KEY=

# smallest.ai voice credits — https://aigrants.in/v/sm
SMALLEST_API_KEY=
SMALLEST_BASE_URL=https://aigrants.in/v/sm

# Google Places API (for location-based venue suggestions)
GOOGLE_PLACES_API_KEY=

# SMTP — powers client/api/capture-email.ts, the optional "email after
# join" endpoint. Any mailbox's SMTP credentials work (Gmail app password,
# etc.) — sending as an existing mailbox skips the sender-domain
# verification a transactional provider would otherwise require. Without
# these set, that endpoint responds 501 and the client-side email flow
# degrades safely (email is optional and must never block room entry).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
