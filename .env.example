# Copy to .env and fill in real values. Never commit .env.
# This is a plain OpenAI API key — call api.openai.com directly, no custom base URL.
OPENAI_API_KEY=

# smallest.ai voice credits — https://aigrants.in/v/sm
SMALLEST_API_KEY=
SMALLEST_BASE_URL=https://aigrants.in/v/sm

# Google Places API (for location-based venue suggestions)
GOOGLE_PLACES_API_KEY=

# Resend (https://resend.com) — powers client/api/capture-email.ts, the
# optional "email after join" endpoint. Without this set, that endpoint
# responds 501 and the client-side email flow degrades safely (email is
# optional and must never block room entry).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
